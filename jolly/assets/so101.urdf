<link name="tool_link"><inertial><mass value=".04"/><inertia ixx=".00005" ixy="0" ixz="0" iyy=".00005" iyz="0" izz=".00005"/></inertial><visual><origin xyz=".02 0 0"/><geometry><box size=".04 .045 .02"/></geometry><material name="black"><color rgba=".1 .1 .12 1"/></material></visual><collision><origin xyz=".02 0 0"/><geometry><box size=".04 .045 .02"/></geometry></collision></link>
<link name="moving_jaw"><inertial><mass value=".02"/><inertia ixx=".00001" ixy="0" ixz="0" iyy=".00001" iyz="0" izz=".00001"/></inertial><visual><origin xyz=".035 0 0"/><geometry><box size=".07 .012 .016"/></geometry><material name="jaw"><color rgba=".85 .85 .88 1"/></material></visual><collision><origin xyz=".035 0 0"/><geometry><box size=".07 .012 .016"/></geometry></collision></link>
<joint name="shoulder_pan" type="revolute"><parent link="base_link"/><child link="shoulder_link"/><origin xyz="0 0 .06"/><axis xyz="0 0 1"/><limit lower="-1.91986" upper="1.91986" effort="10" velocity="10"/><dynamics damping="0.08" friction="0.02"/></joint>
<joint name="shoulder_lift" type="revolute"><parent link="shoulder_link"/><child link="upper_arm_link"/><origin xyz="0 0 .065"/><axis xyz="0 1 0"/><limit lower="-1.74533" upper="1.74533" effort="10" velocity="10"/><dynamics damping="0.08" friction="0.02"/></joint>
