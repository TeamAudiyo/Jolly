<joint name="wrist_roll" type="revolute"><parent link="wrist_link"/><child link="gripper_link"/><origin xyz=".065 0 0"/><axis xyz="1 0 0"/><limit lower="-2.74385" upper="2.84121" effort="10" velocity="10"/><dynamics damping="0.08" friction="0.02"/></joint>
<joint name="tool_fixed" type="fixed"><parent link="gripper_link"/><child link="tool_link"/><origin xyz=".08 0 0"/></joint>
