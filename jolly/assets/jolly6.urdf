<joint name="base_yaw" type="revolute"><parent link="base_link"/><child link="shoulder_link"/><origin xyz="0 0 0.08"/><axis xyz="0 0 1"/><limit lower="-3.14159" upper="3.14159" effort="45" velocity="2.5"/><dynamics damping="0.08" friction="0.02"/></joint>
