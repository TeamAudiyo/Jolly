<joint name="elbow_pitch" type="revolute"><parent link="upper_arm_link"/><child link="forearm_link"/><origin xyz=".20 0 0"/><axis xyz="0 1 0"/><limit lower="-2.6" upper="2.6" effort="45" velocity="2.5"/><dynamics damping="0.08" friction="0.02"/></joint>
<joint name="wrist_pitch" type="revolute"><parent link="forearm_link"/><child link="wrist_pitch_link"/><origin xyz=".18 0 0"/><axis xyz="0 1 0"/><limit lower="-2.6" upper="2.6" effort="45" velocity="2.5"/><dynamics damping="0.08" friction="0.02"/></joint>
