<joint name="wrist_roll" type="revolute"><parent link="wrist_yaw_link"/><child link="wrist_roll_link"/><origin xyz=".06 0 0"/><axis xyz="1 0 0"/><limit lower="-3.14159" upper="3.14159" effort="45" velocity="2.5"/><dynamics damping="0.08" friction="0.02"/></joint>
<joint name="tool_fixed" type="fixed"><parent link="wrist_roll_link"/><child link="tool_link"/><origin xyz=".055 0 0"/></joint>
<joint name="left_finger" type="prismatic"><parent link="tool_link"/><child link="left_finger_link"/><origin xyz=".025 .012 0"/><axis xyz="0 1 0"/><limit lower="0" upper=".03" effort="20" velocity=".2"/></joint>
<joint name="right_finger" type="prismatic"><parent link="tool_link"/><child link="right_finger_link"/><origin xyz=".025 -.012 0"/><axis xyz="0 -1 0"/><limit lower="0" upper=".03" effort="20" velocity=".2"/></joint>
